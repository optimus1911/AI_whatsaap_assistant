# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas Template)
# Format: mongodb+srv://<username>:<password>@<cluster-domain>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/whatsapp_sales_assistant?retryWrites=true&w=majority

# WhatsApp Business API Configuration
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key
